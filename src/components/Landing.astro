---
import Layout from '../layouts/Layout.astro';
import ProjectCard from "../components/ProjectCard.astro"
---

<Layout>
	<section class="greeting">
		<h1>Hello, I'm <span class="accented-word">Iago</span></h1>
		<p>I'm a DevOps enthusiast</p>
	</section>
	
	<section class="projects">
		<h2>Projects</h2>

		<div class="project-grid">
			<ProjectCard
				title="Self-hosting"
				description="Applications running as Docker containers in my NAS"
				href="/projects/self-hosting/"
				technologies={["Docker", "DNS"]}
			/>
			<ProjectCard
				title="GitHub Pages Deployment"
				description="This website is hosted on GitHub Pages and is build on GitHub Actions"
				href="/projects/github-pages/"
				technologies={["Git", "CI/CD"]}
			/>
			<ProjectCard
				title="DevOps Project"
				description="Practise project with everything needed from CI/CD to monitoring"
				href="/projects/devops-project/"
				technologies={["Kubernetes", "Terraform", "Ansible", "Prometheus", "Graphana",]}
			/>
		</div>
	</section>
</Layout>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(100%, 280px), 1fr)
		);
		gap: var(--margin-l);
		margin-top: var(--margin-l);
	}
	.greeting h1 {
		font-size: 3rem;
	}
	.greeting p {
		font: var(--big);
		margin-top: var(--margin-l);
	}
</style>