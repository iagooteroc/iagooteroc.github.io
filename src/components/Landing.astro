---
import Layout from '../layouts/Layout.astro';
import ProjectCard from "../components/ProjectCard.astro"
---

<Layout>
	<section class="greeting">
		<h1 id="about">Hello, I'm <span class="accented-word">Iago</span></h1>
		<p>I'm a computer scientist interested in <b>DevOps</b> practices.</p>
	</section>
	
	<section class="projects">
		<h2 id="projects">Projects</h2>

		<div class="project-grid">
			<!-- <ProjectCard
				title="Self-hosting"
				description="Applications running as Docker containers in my NAS."
				href="/projects/self-hosting/"
				technologies={["Docker", "TLS", "VPN"]}
			/> -->
			<ProjectCard
				title="GitHub Pages Deployment"
				description="This website is hosted on GitHub Pages and is build on GitHub Actions."
				href="/projects/github-pages/"
				technologies={["Git", "Astro"]}
			/>
			<ProjectCard
				title="DevOps Project"
				description="Practical learning project with everything needed from CI/CD to monitoring."
				href="/projects/devops-project/"
				technologies={["Git", "Kubernetes", "Helm", "Argo CD", "Prometheus", "Graphana",]}
			/>
			<ProjectCard
				title="Arch Bootstrap"
				description="Ansible Playbooks to set up all my Arch devices to my liking."
				href="/projects/devops-project/"
				technologies={["Git", "Ansible"]}
			/>
		</div>
	</section>
	
	<section class="contact">
		<h2 id="contact">Contact</h2>
			<ul>
				<li>
					Email: <a href="mailto:i.otero.coto@gmail.com">i.otero.coto@gmail.com</a>
				</li>
			</ul>
	</section>
</Layout>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(100%, 280px), 1fr)
		);
		gap: var(--margin-l);
		margin-top: var(--margin-l);
	}
	.greeting h1 {
		font-size: 3rem;
	}
	.greeting p {
		font: var(--big);
		margin-top: var(--margin-l);
	}
</style>