---
import "../styles/global.css"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Iago's Website</title>
	</head>
	<body>
		<main class="content">
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		font-family: var(--ff);
		text-wrap: balance;
		background: var(--bg);
		color: var(--text);
	}

	button {
		background: var(--bg-light);
		padding: 0.5rem 1rem 0.7rem 1rem;
		color: var(--text)
		font-weight: 700;
		border-radius: 0.5rem;
		margin-top: 1.5rem;
		border: none;
	}

	/* Landing page */
	:global(h1) { font: var(--h1); }
	:global(h2) { font: var(--h2); }
	:global(h3) { font: var(--h3); }
	:global(h4) { font: var(--h4); }
	:global(.big) { font: var(--big); }
	:global(p) { font: var(--p); }
	:global(.small) { font: var(--small); }

	/* UIs */
	:global(.ui h1) { font: var(--h1ui); }
	:global(.ui h2) { font: var(--h2ui); }
	:global(.ui h3) { font: var(--h3ui); }
	:global(.ui h4) { font: var(--h4ui); }
	:global(.ui .big) { font: var(--bigui); }
	:global(.ui p) { font: var(--pui); }
	:global(.ui .small) { font: var(--smallui); }

	/* Shared styles */
	/* :global(.ts) { color: var(--gray70); } */

	:global(h1, h2, h3, h4, .big, p, .small) {
		margin: 0;
		margin-top: 2rem;
	}

	:global(.ui) {
		margin-top: 4rem;
	}
	
</style>
